{
    "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
    "id": "cba99a4e-1c8f-432d-8b28-280caaea27c9",
    "name": "alle-bd-sec-scan",
    "friendlyName": "Alle BlackDuck Security Scan",
    "description": "Simple scan to bring scan information into the build pipeline.",
    "helpMarkDown": "",
    "category": "Utility",
    "author": "ProductTech",
    "version": {
        "Major": 0,
        "Minor": 1,
        "Patch": 1
    },
    "instanceNameFormat": "Black Duck Vulnerability Result",
    "inputs": [
        {
            "name": "blackduckconnection",
            "type": "connectedService:SynopsysBlackDuck",
            "label": "Service connection name for Black Duck",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "connection string name"
        },
        {
            "name": "projectName",
            "type": "string",
            "label": "Black Duck Project Name",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Name of Black Duck project"
        },
        {
            "name": "versionName",
            "type": "string",
            "label": "Black Duck Version Name",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Name of Black Duck version"
        },
        {
            "name": "excludeViolations",
            "type": "string",
            "label": "Comma seperated list of names of components to exclude",
            "defaultValue": "",
            "required": false,
            "helpMarkDown": "Provide a comma seperated list of component names in Black Duck to exclude from build failures"
        }
    ],
    "execution": {
        "Node10": {
            "target": "./dist/index.js"
        }
    }
}